# ==============================================================================
# Skylark Drones - Monday.com Business Intelligence Agent
# Environment Configuration
# ==============================================================================

# Monday.com Integration (Primary: GraphQL API v2)
MONDAY_API_TOKEN=your_monday_personal_api_token_here
DEALS_BOARD_ID=your_deals_board_id_here
WORK_ORDERS_BOARD_ID=your_work_orders_board_id_here
MONDAY_API_VERSION=2024-10

# Data Source Switcher: 'graphql' (default) | 'mcp'
MONDAY_DATA_SOURCE=graphql

# Optional MCP Configuration (if MONDAY_DATA_SOURCE=mcp)
MONDAY_MCP_SERVER_URL=http://localhost:8000/mcp

# LLM Provider Failover Chain (Gemini -> GLM -> Groq -> OpenRouter)
GEMINI_API_KEY=your_gemini_api_key_here
GLM_API_KEY=your_glm_z_ai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# App & Cache Configuration
CACHE_TTL_SECONDS=300
AS_OF_DATE=auto
NEXT_PUBLIC_APP_NAME="Skylark Drones - Monday.com BI Agent"

# Upstash Redis Configuration (Distributed Rate Limiting for Serverless)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

